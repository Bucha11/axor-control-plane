# Copy to .env before `docker compose up --build`.
#
# The defaults below are the OPEN DEV POSTURE — zero-config demo, everything
# reachable without a token, unsigned plane commands accepted. The backend
# logs a loud warning while running like this.

# ── SECURE THIS for any deployment that isn't localhost ──────────────────────
# Uncomment and fill these three; everything else can stay as-is.
# See SECURITY.md for the full hardening checklist (TLS, backups, Postgres).
#
# 1. Require a bearer token on the API (generate: openssl rand -hex 24), then
#    paste the same value into the UI (Settings → auth):
#AXOR_API_TOKEN=
# 2. Refuse unsigned plane commands:
#AXOR_ALLOW_UNSIGNED=0
# 3. Operator Ed25519 public keys (JSON op -> hex), the signing counterpart:
#AXOR_OPERATOR_KEYS={"op_you":"<ed25519-pubkey-hex>"}

# ── required ─────────────────────────────────────────────────────────────────
# Postgres password.
AXOR_PG_PASSWORD=change-me

# Backend database. Compose points this at the Postgres above; unset falls back
# to a local SQLite file, which is fine for evaluation and not for a fleet
# (docs/ops-limits.md has the measured numbers).
AXOR_DATABASE_URL=

# GitHub token used ONLY at build time to fetch the private ecosystem deps
# (axor-core / axor-eval). A classic PAT with `repo` read scope is enough.
# Leave empty if your build network already reaches the repos.
GITHUB_TOKEN=

# ── dev defaults (the open posture the warning is about) ─────────────────────
# Backend master token. Empty = auth OFF (open).
AXOR_API_TOKEN=
# Scoped `ingest` API key the proxy uses to upload runs when auth is on. Mint it
# in the UI (Settings → API keys) after first boot, then set it here and restart
# the proxy. Empty is fine while AXOR_API_TOKEN is empty.
AXOR_INGEST_KEY=
# Demo mock tools on the proxy (1 = on). Set 0 and mount a tools.json for real tools.
AXOR_PROXY_DEMO=1
# Accept unsigned plane commands from the UI (1 = dev only).
AXOR_ALLOW_UNSIGNED=1
# JSON map of operator id -> ed25519 public key (hex).
AXOR_OPERATOR_KEYS={}

# ── axor-identity (human login) ──────────────────────────────────────────────
# The identity service issues the access tokens humans log in with; the backend
# verifies them against its JWKS (wired to http://identity:8402 by compose).
# Stable EdDSA signing key (PKCS#8 PEM, one line with \n escapes or a block).
# Empty = a throwaway key generated at each boot (DEV ONLY: logins break on
# restart). Generate one:
#   docker compose run --rm identity python -c "from axor_identity.keys import generate_pem; print(generate_pem())"
AXOR_IDENTITY_SIGNING_KEY=
# Where the backend fetches the JWKS. Clear to run WITHOUT identity login
# (operator token + API keys still work).
#AXOR_IDENTITY_JWKS_URL=http://identity:8402/.well-known/jwks.json
# …or paste the JWKS document itself, for an air-gapped install with no URL to
# fetch. Takes precedence over the URL; with a URL the backend can refetch after
# identity rotates a key, with an inline document it cannot.
AXOR_IDENTITY_JWKS=
# The `iss` claim an access token must carry. Change it only if you run your own
# identity under its own name.
AXOR_IDENTITY_ISSUER=axor-identity
# Vendor public key (hex) — the licensing trust root, and the ONLY key an EE
# license is verified against. Settings → LICENSE is inert until this is set:
# a signature checked against a key typed into the same form proves nothing, so
# the key is pinned here by the operator and never accepted from a request. It
# ships with the distribution. Leave empty if you are not using EE.
AXOR_VENDOR_PUBKEY=
# The organization your license is issued to — the `organization` field printed
# on it. A license names its organization inside the SIGNED payload, so setting
# this makes a licence issued to another customer refuse to activate here.
# Leave empty and any vendor-signed license activates; boot warns when it is.
AXOR_ORG=
# Where this deployment FETCHES its next license, when the vendor runs a
# renewal endpoint. Empty = off, and licenses are pasted by hand in Settings —
# the only flow an air-gapped install can have. When set, the control plane
# dials OUT for its next license inside the last three weeks of the current
# one, the same way a governed node dials out for its desired state: no inbound
# surface, works behind NAT. Everything fetched is checked exactly like a
# pasted license, and a renewal can only move the expiry forward.
AXOR_LICENSE_RENEWAL_URL=
# Report this deployment's governed-node usage to the vendor on the renewal
# call. Empty = off, and it is NOT implied by AXOR_LICENSE_RENEWAL_URL: renewal
# is the vendor answering a question about your deployment, this is your
# deployment volunteering something about you, and agreeing to the first is not
# agreeing to the second.
# What is sent, for the last CLOSED month only: the rung, the licensed ceiling,
# the peak number of governed nodes on any one day and which day, the distinct
# count, and how many were past the allowance. Counts only — never node ids,
# never anything about what those nodes did. `GET /v1/license/invoice` shows the
# same figures and more, so you can read exactly what would leave before you
# switch this on.
AXOR_USAGE_REPORTING=
# An EE license as text, instead of pasting it in Settings. Empty = paste it.
AXOR_LICENSE=
# Retention window in days for runs (backend: events/pins/share-links) and
# proxy trace files. Empty = keep forever.
AXOR_RETENTION_DAYS=
# Stripe payment link baked into the Pricing "Get Team" button at frontend
# BUILD time (compose passes it as a build arg). Empty = mailto fallback.
VITE_CHECKOUT_URL=

# ── Hardening (audit F-12..F-18) ─────────────────────────────────────────────
# Separate credential per vault subsystem (spec v2 Ch.5 §3: the ability to
# dispense tool credentials must not grant the ability to request signatures).
# Unset = the wall is down and admin scope is the only check; the backend says
# so loudly at startup.
AXOR_VAULT_CREDS_TOKEN=
AXOR_VAULT_SIGNING_TOKEN=

# Sink-side credential injection (ui-spec §14.2) — PROXY-side, comma-separated.
# Vault mode is a mode, never the default: for these tools and no others the
# proxy fetches the credential at call time and injects it at the sink, so the
# agent never holds it. Section 6 passthrough (auth byte-for-byte, never parsed)
# stays literally true for every tool not listed here. Empty = pure passthrough.
#
# Fail closed: vault unreachable, credential missing, revoked or out of this
# node's scope means a typed denial and no upstream call. There is no cache and
# no break-glass (decision #14) — a TTL cache would put the secret back on the
# proxy, which is what the feature removes.
AXOR_VAULT_TOOLS=

# Node signing seed (ed25519, 32 bytes hex) — PROXY-side, optional. With it,
# every credential fetch carries a signed attestation naming the call it is for;
# register the public half with the plane (POST /v1/vault/creds/node-keys) and
# the dispense log records `signed: true`. It is not authentication — the
# request already carries a node-bound key — it is non-repudiation: a customer
# on a hosted deployment can verify their own dispense log against their own
# node's key without trusting the backend that stored it. Once a key is
# registered for a node, unsigned fetches from it are refused.
AXOR_NODE_SIGNING_SEED=

# Credential-sealing private key (X25519, 32 bytes hex) — PROXY-side. Envelope
# mode (ui-spec §14.2): with a sealing PUBLIC key registered on the plane, the
# backend stores only a `sealed_secret` it has no key for, and this node opens
# it at the sink. That is §14.2's stated condition for a hosted vault — the
# backend is not trusted to decline to look, it is unable to.
#
# Mint the pair with `axor-proxy vault keygen`: the seed goes here, the public
# half to POST /v1/vault/creds/sealing-key. Seal each credential before
# enrolling with `axor-proxy vault seal --public-key <hex>`. A sealed credential
# this node cannot open is a denial, never a call without it.
AXOR_CRED_SEALING_SEED=

# Bearer required on the proxy's /axor control routes (arm runs, inject faults
# into live tool traffic, spawn governed nodes, read traces). Unset is fine on
# loopback; compose publishes port 8401, so set it for anything shared.
#
# Consumed by TWO services: the proxy enforces it, and the frontend's nginx
# attaches it on the /axor hop so the browser never holds an infrastructure
# secret. They read the same variable, so one value covers both. Charset is
# [A-Za-z0-9._~+/=:-]; anything else aborts the frontend container rather than
# silently forwarding /axor unauthenticated.
AXOR_PROXY_TOKEN=

# Refuse webhooks aimed at loopback/private addresses. Turns itself on whenever
# identity login is configured (there an org admin holds `operate` without
# being the infrastructure operator). Leave unset on a single-tenant deployment
# whose collector genuinely sits on the compose network — the cloud-metadata
# range is refused either way.
#AXOR_WEBHOOK_BLOCK_PRIVATE=1

# Per-request ceilings. Generous by default: a real multi-node trace is
# thousands of events, not millions. Each is a positive whole number; anything
# else refuses to start and says which variable it was.
#AXOR_MAX_EVENTS_PER_BATCH=10000
#AXOR_SUBGRAPH_CACHE_MAX=512
# Regression pins one uploaded Lab package may carry — each is content-hashed,
# converted and REPLAYED before the request answers.
#AXOR_MAX_PINS_PER_PACKAGE=500
# Bounds on the per-run provenance walk, which `?k=` and `?limit=` would
# otherwise size from the query string.
#AXOR_MAX_KHOP_K=30
#AXOR_MAX_KHOP_LIMIT=1000

# ── background cadence ───────────────────────────────────────────────────────
# How long a node may be silent before node_stale fires, and how often the
# sweep looks. Defaults are 3T and T, T being the 10s heartbeat period.
#AXOR_STALE_AFTER=30
#AXOR_STALE_SWEEP_INTERVAL=10
# How often the EE scheduler checks whether a corpus run is due.
#AXOR_SCHEDULE_SWEEP_SECONDS=60

# ── observability (launch-readiness §6) ──────────────────────────────────────
# One JSON object per log line, shippable to any collector without an agent.
AXOR_LOG_JSON=
# Ship unhandled errors to Sentry. Needs the sentry-sdk package installed;
# without it the backend logs that it was asked and could not.
SENTRY_DSN=

# ── vendor-side only ─────────────────────────────────────────────────────────
# The vendor's ed25519 PRIVATE key, used by `axor-backend-ee` to SIGN licenses.
# It belongs to whoever issues licenses, never to a deployment that runs them:
# a customer sets AXOR_VENDOR_PUBKEY (above) and nothing else.
AXOR_VENDOR_KEY=
