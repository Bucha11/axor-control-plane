# Copy to .env before `docker compose up --build`.
#
# The defaults below are the OPEN DEV POSTURE — zero-config demo, everything
# reachable without a token, unsigned plane commands accepted. The backend
# logs a loud warning while running like this.

# ── SECURE THIS for any deployment that isn't localhost ──────────────────────
# Uncomment and fill these three; everything else can stay as-is.
# See SECURITY.md for the full hardening checklist (TLS, backups, Postgres).
#
# 1. Require a bearer token on the API (generate: openssl rand -hex 24), then
#    paste the same value into the UI (Settings → auth):
#AXOR_API_TOKEN=
# 2. Refuse unsigned plane commands:
#AXOR_ALLOW_UNSIGNED=0
# 3. Operator Ed25519 public keys (JSON op -> hex), the signing counterpart:
#AXOR_OPERATOR_KEYS={"op_you":"<ed25519-pubkey-hex>"}

# ── required ─────────────────────────────────────────────────────────────────
# Postgres password.
AXOR_PG_PASSWORD=change-me

# GitHub token used ONLY at build time to fetch the private ecosystem deps
# (axor-core / axor-eval). A classic PAT with `repo` read scope is enough.
# Leave empty if your build network already reaches the repos.
GITHUB_TOKEN=

# ── dev defaults (the open posture the warning is about) ─────────────────────
# Backend master token. Empty = auth OFF (open).
AXOR_API_TOKEN=
# Scoped `ingest` API key the proxy uses to upload runs when auth is on. Mint it
# in the UI (Settings → API keys) after first boot, then set it here and restart
# the proxy. Empty is fine while AXOR_API_TOKEN is empty.
AXOR_INGEST_KEY=
# Demo mock tools on the proxy (1 = on). Set 0 and mount a tools.json for real tools.
AXOR_PROXY_DEMO=1
# Accept unsigned plane commands from the UI (1 = dev only).
AXOR_ALLOW_UNSIGNED=1
# JSON map of operator id -> ed25519 public key (hex).
AXOR_OPERATOR_KEYS={}
# Vendor public key (hex) for EE license verification (Settings → license).
AXOR_VENDOR_PUBKEY=
# Retention window in days for runs (backend: events/pins/share-links) and
# proxy trace files. Empty = keep forever.
AXOR_RETENTION_DAYS=
# Stripe payment link baked into the Pricing "Get Team" button at frontend
# BUILD time (compose passes it as a build arg). Empty = mailto fallback.
VITE_CHECKOUT_URL=
