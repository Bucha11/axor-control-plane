# The only public entry point. Caddy obtains and renews Let's Encrypt
# certificates on its own. It needs ports 80 and 443 open and CP_HOST's DNS A
# record pointing at this server.
#
# No `encode` here: compressing an SSE response can hold events in the encoder
# buffer, and the app streams live runs over SSE. Caddy flushes
# text/event-stream responses immediately without it.
{
	email {$ACME_EMAIL}
}

# The frontend nginx serves the SPA and proxies /v1, /axor and /identity itself.
{$CP_HOST} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy frontend:8080
}

# Optional sites. bootstrap.sh --with-lab writes sites/lab.caddy; with no file
# there this glob matches nothing and Caddy carries on.
import /etc/caddy/sites/*.caddy
