# Self-hosted Axor Control Plane. `./bootstrap.sh <host> <acme-email>` writes
# this file with every secret generated; everything below it fills in is marked.
# Copy it by hand only if you would rather not run the script.

# ── the two settings you actually choose ─────────────────────────────────────
# The hostname this install answers on. Its DNS A record must point at this
# server before the first start, or Let's Encrypt cannot validate it.
CP_HOST=axor.example.com
# Where Let's Encrypt sends expiry warnings.
ACME_EMAIL=

# Who may create an account:
#   first-only  the first account claims the install, the rest are refused
#   closed      nobody; an org admin adds people by e-mail instead
#   open        anyone — for a public host this hands strangers an org on your
#               server, so it is not the default here
# Closing signup does not close the install: login, refresh and membership all
# keep working, so the admin goes on adding colleagues.
AXOR_IDENTITY_SIGNUP=first-only

# ── generated by bootstrap.sh; no need to touch ──────────────────────────────
AXOR_PG_PASSWORD=
# The operator master token. Auth is OFF while this is empty, which on a public
# hostname means every endpoint is open — bootstrap.sh never leaves it empty.
AXOR_API_TOKEN=
AXOR_PROXY_TOKEN=
# Stable EdDSA signing key. A throwaway one logs every user out on each restart.
AXOR_IDENTITY_SIGNING_KEY=

# ── optional ─────────────────────────────────────────────────────────────────
# Scoped key the proxy uses to upload traces. Mint it in Settings → API keys
# after the first boot, then set it here and `docker compose up -d proxy`.
AXOR_INGEST_KEY=
# Demo mock tools on the proxy (1 = on). Set 0 and mount a tools.json for real
# tools.
AXOR_PROXY_DEMO=1
# Operator ed25519 public keys for signed plane commands. Leave
# AXOR_ALLOW_UNSIGNED=0 and fill this for a real deployment.
AXOR_ALLOW_UNSIGNED=0
AXOR_OPERATOR_KEYS={}

# ── image ────────────────────────────────────────────────────────────────────
# A released version. `latest` follows releases; pin an exact one once you have
# users, so a rollback is the previous tag.
AXOR_TAG=0.4.0

# ── Axor Lab (optional) ──────────────────────────────────────────────────────
# Filled in by `bootstrap.sh … --with-lab`. COMPOSE_PROFILES=lab is what makes
# plain `docker compose up -d` (and upgrades) include it.
COMPOSE_PROFILES=
LAB_HOST=
AXOR_LAB_CONTROL_TOKEN=
LAB_TAG=edge
