# Production settings for deploy/prod. Copy to .env (chmod 600) and fill in
# every REQUIRED value. `docker compose` refuses to start while one is empty.
# Generate secrets with:  openssl rand -hex 24

# ── hosts (REQUIRED) ─────────────────────────────────────────────────────────
# DNS A records for both must point at this server BEFORE the first start, or
# Caddy cannot obtain certificates. The landings live on GitHub Pages under
# landing-plane. / landing-lab. (see README.md).
CP_HOST=plane.useaxor.net
LAB_HOST=lab.useaxor.net
# Let's Encrypt account e-mail (expiry notices).
ACME_EMAIL=

# ── database (REQUIRED) ──────────────────────────────────────────────────────
AXOR_PG_PASSWORD=

# ── Control Plane (REQUIRED) ─────────────────────────────────────────────────
# Backend master bearer. Paste the same value into the UI (Settings → auth).
AXOR_API_TOKEN=
# The proxy's control-surface credential. nginx in the frontend image attaches
# it on the /axor hop, so it never reaches a browser.
AXOR_PROXY_TOKEN=
# Stable EdDSA signing key for axor-identity (PKCS#8 PEM). Generate:
#   docker compose run --rm --no-deps identity python -c "from axor_identity.keys import generate_pem; print(generate_pem())"
# Paste it as a double-quoted multi-line value:
#   AXOR_IDENTITY_SIGNING_KEY="-----BEGIN PRIVATE KEY-----
#   ...
#   -----END PRIVATE KEY-----"
AXOR_IDENTITY_SIGNING_KEY=

# ── Control Plane (optional) ─────────────────────────────────────────────────
# Scoped `ingest` API key the proxy uploads runs with. Mint it in the UI
# (Settings → API keys) after the first boot, set it here, then
# `docker compose up -d proxy`.
AXOR_INGEST_KEY=
# 0 (default here) refuses unsigned plane commands; then set operator keys.
# Set 1 only for a demo instance.
AXOR_ALLOW_UNSIGNED=0
AXOR_OPERATOR_KEYS={}
# Demo mock tools on the proxy (1 = on).
AXOR_PROXY_DEMO=1
# EE licensing: vendor public key (hex) and your organization name.
AXOR_VENDOR_PUBKEY=
AXOR_ORG=
# Per-vault-subsystem credentials. Empty leaves the vault wall down; the
# backend warns about it at startup.
AXOR_VAULT_CREDS_TOKEN=
AXOR_VAULT_SIGNING_TOKEN=
# Error reporting (optional).
SENTRY_DSN=

# ── Axor Lab (REQUIRED) ──────────────────────────────────────────────────────
# Operator bearer; every write is gated on it until a workspace has members.
AXOR_LAB_CONTROL_TOKEN=

# ── Axor Lab (optional) ──────────────────────────────────────────────────────
AXOR_LAB_ADMIN_TOKEN=
AXOR_LAB_BILLING_WEBHOOK_SECRET=
# 1 enables anonymous 30-minute trial workspaces (rate-limited by lab-edge).
AXOR_LAB_GUEST_SESSIONS=

# ── images ───────────────────────────────────────────────────────────────────
# latest = most recent vX.Y.Z release, edge = tip of main. Pin an exact version
# (e.g. 0.14.2) for reproducible upgrades and rollbacks.
AXOR_TAG=latest
LAB_TAG=edge
#AXOR_IMAGE=ghcr.io/bucha11/axor-platform
#AXOR_FRONTEND_IMAGE=ghcr.io/bucha11/axor-frontend
#LAB_IMAGE=ghcr.io/bucha11/axor-lab

# ── backups (deploy/prod/backup.sh) ──────────────────────────────────────────
# Local copies kept on the server.
BACKUP_DIR=/var/backups/axor
BACKUP_KEEP_DAYS=14
# rclone remote:path for off-site copies (e.g. a Cloudflare R2 bucket
# configured with `rclone config`). Empty = local only.
BACKUP_RCLONE_REMOTE=
